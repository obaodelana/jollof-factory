[["Map",1,2,9,10,114,115,158,159,192,193],"meta::meta",["Map",3,4,5,6,7,8],"astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"csp\":false,\"actionBodySizeLimit\":1048576,\"serverIslandBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"prerenderConflictBehavior\":\"warn\",\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"chromeDevtoolsWorkspace\":false,\"svgo\":false,\"rustCompiler\":false,\"queuedRendering\":{\"enabled\":false}},\"legacy\":{\"collectionsBackwardsCompat\":false}}","astro-version","6.0.4","content-config-digest","8504cd058d411a80","recipes",["Map",11,12,47,48,80,81],"jollof-honey-chicken",{"id":11,"data":13,"filePath":35,"digest":36,"rendered":37},{"id":14,"slug":11,"title":15,"description":16,"image":17,"ingredients":18,"directions":26},1,"Jollof Honey Chicken","Sweet, spicy, and incredibly juicy. A perfect weeknight star.","/images/recipes/honey-chicken.png",[19,20,21,22,23,24,25],"2 tbsp Jollof Factory Base","1 lb Chicken drumsticks or wings","2 tbsp Honey","1 tsp Olive oil","1/2 Lemon (for juice)","Salt & Seasonings to taste","Fresh coriander, chopped (for garnish)",[27,28,29,30,31,32,33,34],"Clean chicken and pat dry thoroughly.","In a bowl, combine Jollof Factory base with your favorite seasonings and salt. Mix well.","Add the chicken to the bowl and coat evenly. Add a tablespoon of honey and a dash of lemon juice.","Allow to marinate for at least 20 minutes, or overnight for deeper flavor.","Grill, bake, or air-fry chicken until cooked through and golden brown.","In a small bowl, mix the remaining honey and 1 tsp of olive oil. Drizzle over the cooked chicken.","Sprinkle with chopped coriander for a fresh finish.","Enjoy immediately!","src/content/recipes/jollof-honey-chicken.md","b9e59ee74de49fb7",{"html":38,"metadata":39},"",{"headings":40,"localImagePaths":41,"remoteImagePaths":42,"frontmatter":43,"imagePaths":46},[],[],[],{"id":14,"slug":11,"title":15,"description":16,"image":17,"ingredients":44,"directions":45},[19,20,21,22,23,24,25],[27,28,29,30,31,32,33,34],[],"jollof-rice",{"id":47,"data":49,"filePath":69,"digest":70,"rendered":71},{"id":50,"slug":47,"title":51,"description":52,"image":53,"cookingTime":54,"ingredients":55,"directions":61},3,"Jollof Rice","The iconic West African dish, made foolproof and fast.","/images/recipes/jollof-rice.png","30 - 35 min",[56,57,58,59,60],"1 Jar of Jollof Factory Base","3 cups Parboiled raw rice","3 cups Stock (beef, chicken, or vegetable)","Salt and seasonings to taste","1 tbsp Butter (optional)",[62,63,64,65,66,67,68],"Rinse your rice thoroughly under cold water until the water runs clear, then drain.","In a medium-sized pot, combine the rinsed rice with the entire jar of Jollof Factory base. Stir to combine.","Pour in the stock and add salt and your preferred seasonings to taste. Stir once more.","Bring to a boil, then reduce the heat to low, cover the pot tightly, and let it simmer.","Cook for 25-30 minutes. Check if it needs a little more water to cook throughly. Avoid stirring too much.","Once the rice is cooked, turn off the heat. Add butter if you like a more buttery taste and fluff with a fork.","Serve hot and enjoy the authentic taste of Jollof!","src/content/recipes/jollof-rice.md","797b644a32e0fab5",{"html":38,"metadata":72},{"headings":73,"localImagePaths":74,"remoteImagePaths":75,"frontmatter":76,"imagePaths":79},[],[],[],{"id":50,"slug":47,"title":51,"description":52,"image":53,"cookingTime":54,"ingredients":77,"directions":78},[56,57,58,59,60],[62,63,64,65,66,67,68],[],"pizza-with-a-twist",{"id":80,"data":82,"filePath":103,"digest":104,"rendered":105},{"id":83,"slug":80,"title":84,"description":85,"image":86,"ingredients":87,"directions":96},2,"Pizza with a Twist","Swap out boring marinara for a bold, African-inspired base.","https://images.unsplash.com/photo-1594007654729-407eedc4be65?auto=format&fit=crop&w=800&q=80",[88,89,90,91,92,93,94,95],"1 Pizza dough (store-bought or homemade)","3-4 tbsp Jollof Factory Base","1½ cups Shredded mozzarella cheese","½ Red onion, thinly sliced","1 Bell pepper (red or yellow), thinly sliced","Your preferred protein (e.g., grilled chicken, sausage)","Sweetcorn (optional)","Fresh basil or parsley for garnish",[97,98,99,100,101,102],"Preheat your oven to 475°F (245°C). Place a pizza stone or baking sheet inside to heat up.","On a lightly floured surface, roll out your pizza dough to your desired thickness.","Carefully transfer the dough to parchment paper. Spread 3-4 tbsp of Jollof Factory base evenly, leaving a small border.","Sprinkle mozzarella cheese over the sauce, then add your toppings: red onion, bell pepper, protein, and sweetcorn.","Bake for 12-15 minutes, or until the crust is golden and the cheese is bubbly and slightly browned.","Garnish with fresh basil or parsley, slice, and enjoy a delicious African-inspired pizza!","src/content/recipes/pizza-with-a-twist.md","fd83bfae6055bddc",{"html":38,"metadata":106},{"headings":107,"localImagePaths":108,"remoteImagePaths":109,"frontmatter":110,"imagePaths":113},[],[],[],{"id":83,"slug":80,"title":84,"description":85,"image":86,"ingredients":111,"directions":112},[88,89,90,91,92,93,94,95],[97,98,99,100,101,102],[],"steps",["Map",116,117,130,131,144,145],"eat-it",{"id":116,"data":118,"filePath":121,"digest":122,"rendered":123},{"id":50,"number":50,"title":119,"description":120},"Eat It","Simmer 10 mins. Serve. Take all the credit.","src/content/steps/eat-it.md","59b7a9a84150ab02",{"html":38,"metadata":124},{"headings":125,"localImagePaths":126,"remoteImagePaths":127,"frontmatter":128,"imagePaths":129},[],[],[],{"id":50,"number":50,"title":119,"description":120},[],"heat-it",{"id":130,"data":132,"filePath":135,"digest":136,"rendered":137},{"id":14,"number":14,"title":133,"description":134},"Heat It","Warm up oil in your pan. Get it sizzling.","src/content/steps/heat-it.md","2b9a71f06efdc8aa",{"html":38,"metadata":138},{"headings":139,"localImagePaths":140,"remoteImagePaths":141,"frontmatter":142,"imagePaths":143},[],[],[],{"id":14,"number":14,"title":133,"description":134},[],"mix-it",{"id":144,"data":146,"filePath":149,"digest":150,"rendered":151},{"id":83,"number":83,"title":147,"description":148},"Mix It","Toss in protein/veggies & a big scoop of Base.","src/content/steps/mix-it.md","380788802b39856b",{"html":38,"metadata":152},{"headings":153,"localImagePaths":154,"remoteImagePaths":155,"frontmatter":156,"imagePaths":157},[],[],[],{"id":83,"number":83,"title":147,"description":148},[],"testimonials",["Map",160,161,176,177],"alicia",{"id":160,"data":162,"filePath":167,"digest":168,"rendered":169},{"quote":163,"emphasized":164,"name":165,"context":166},"Avaya ate a big bowl in bed while studying.","big bowl","Alicia","I went with gnocchi and rice…","src/content/testimonials/alicia.md","dadffb94d53c168a",{"html":38,"metadata":170},{"headings":171,"localImagePaths":172,"remoteImagePaths":173,"frontmat