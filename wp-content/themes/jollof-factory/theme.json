{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1000px",
			"wideSize": "1280px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#FF4D00",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#FFD93D",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#0D4232",
					"name": "Accent"
				},
				{
					"slug": "background",
					"color": "#F9F5F0",
					"name": "Background"
				},
				{
					"slug": "dark",
					"color": "#121212",
					"name": "Dark"
				},
				{
					"slug": "neutral",
					"color": "#E5E5E5",
					"name": "Neutral"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "archivo-black",
					"name": "Archivo Black",
					"fontFamily": "\"Archivo Black\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo Black",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/archivo-black/archivo-black-400-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Archivo Black",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/archivo-black/archivo-black-400-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "plus-jakarta-sans",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "500 800",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-500-800-cyrillic-ext.woff2"
							],
							"unicodeRange": "U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F"
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "500 800",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-500-800-vietnamese.woff2"
							],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "500 800",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-500-800-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "500 800",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-500-800-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "permanent-marker",
					"name": "Permanent Marker",
					"fontFamily": "\"Permanent Marker\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Permanent Marker",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/permanent-marker/permanent-marker-400-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "display",
					"size": "clamp(2.5rem, 7vw, 6rem)",
					"name": "Display"
				},
				{
					"slug": "headline",
					"size": "clamp(1.75rem, 4vw, 3rem)",
					"name": "Headline"
				},
				{
					"slug": "body",
					"size": "1.0625rem",
					"name": "Body"
				},
				{
					"slug": "label",
					"size": "0.8125rem",
					"name": "Label"
				},
				{
					"slug": "marker",
					"size": "1.5rem",
					"name": "Marker"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "xs",
					"size": "8px",
					"name": "Extra small"
				},
				{
					"slug": "sm",
					"size": "16px",
					"name": "Small"
				},
				{
					"slug": "md",
					"size": "32px",
					"name": "Medium"
				},
				{
					"slug": "lg",
					"size": "64px",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "96px",
					"name": "Extra large"
				},
				{
					"slug": "xxl",
					"size": "128px",
					"name": "Xxl"
				}
			]
		},
		"custom": {
			"rounded": {
				"none": "0px"
			}
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 5vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 5vw, 3rem)"
			}
		},
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|dark"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|plus-jakarta-sans",
			"fontSize": "var:preset|font-size|body",
			"fontWeight": "500",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|archivo-black",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|dark",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "0px",
					"width": "2px",
					"style": "solid",
					"color": "var:preset|color|dark"
				},
				"shadow": "4px 4px 0 var(--wp--preset--color--dark)",
				"spacing": {
					"padding": {
						"top": "16px",
						"right": "32px",
						"bottom": "16px",
						"left": "32px"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|plus-jakarta-sans",
					"fontSize": "var:preset|font-size|label",
					"fontWeight": "800",
					"lineHeight": "1.2",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
