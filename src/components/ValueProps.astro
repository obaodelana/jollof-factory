---
import { getCollection } from 'astro:content';
import { Flame, Utensils, Timer, CheckCircle2 } from 'lucide-react';

const values = await getCollection('values');
const sortedValues = values.sort((a: any, b: any) => a.data.id - b.data.id);
---

<section class="w-full py-24 bg-dark text-cream border-t-2 border-white">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="mb-16 flex flex-col items-center text-center">
      <h2 class="text-5xl md:text-7xl font-display uppercase text-secondary mb-6">
        Why It Slaps
      </h2>
      <p class="text-xl md:text-2xl text-white font-bold max-w-2xl font-marker text-primary -rotate-1">
        (And why you need it in your pantry right now)
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="group flex flex-col gap-4 p-8 border-2 border-white hover:bg-white hover:text-dark transition-colors duration-300 bg-transparent">
        <div class="flex h-20 w-20 items-center justify-center bg-primary text-dark border-2 border-white shadow-[4px_4px_0px_0px_#fff] mb-4 group-hover:rotate-12 transition-transform">
          <Flame size={40} strokeWidth={2.5} client:visible />
        </div>
        <div>
          <h3 class="font-display text-2xl mb-3 uppercase tracking-wide">
            {sortedValues[0].data.title}
          </h3>
          <p class="text-lg leading-relaxed font-medium opacity-90">
            {sortedValues[0].data.description}
          </p>
        </div>
      </div>
      
      <div class="group flex flex-col gap-4 p-8 border-2 border-white hover:bg-white hover:text-dark transition-colors duration-300 bg-white/5">
        <div class="flex h-20 w-20 items-center justify-center bg-primary text-dark border-2 border-white shadow-[4px_4px_0px_0px_#fff] mb-4 group-hover:rotate-12 transition-transform">
          <Utensils size={40} strokeWidth={2.5} client:visible />
        </div>
        <div>
          <h3 class="font-display text-2xl mb-3 uppercase tracking-wide">
            {sortedValues[1].data.title}
          </h3>
          <p class="text-lg leading-relaxed font-medium opacity-90">
            {sortedValues[1].data.description}
          </p>
        </div>
      </div>
      
      <div class="group flex flex-col gap-4 p-8 border-2 border-white hover:bg-white hover:text-dark transition-colors duration-300 bg-transparent">
        <div class="flex h-20 w-20 items-center justify-center bg-primary text-dark border-2 border-white shadow-[4px_4px_0px_0px_#fff] mb-4 group-hover:rotate-12 transition-transform">
          <Timer size={40} strokeWidth={2.5} client:visible />
        </div>
        <div>
          <h3 class="font-display text-2xl mb-3 uppercase tracking-wide">
            {sortedValues[2].data.title}
          </h3>
          <p class="text-lg leading-relaxed font-medium opacity-90">
            {sortedValues[2].data.description}
          </p>
        </div>
      </div>
      
      <div class="group flex flex-col gap-4 p-8 border-2 border-white hover:bg-white hover:text-dark transition-colors duration-300 bg-white/5">
        <div class="flex h-20 w-20 items-center justify-center bg-primary text-dark border-2 border-white shadow-[4px_4px_0px_0px_#fff] mb-4 group-hover:rotate-12 transition-transform">
          <CheckCircle2 size={40} strokeWidth={2.5} client:visible />
        </div>
        <div>
          <h3 class="font-display text-2xl mb-3 uppercase tracking-wide">
            {sortedValues[3].data.title}
          </h3>
          <p class="text-lg leading-relaxed font-medium opacity-90">
            {sortedValues[3].data.description}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
